{
  "expo": {
    "name": "DisasterChain",
    "slug": "disasterchain",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "disasterchain",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0E0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.disasterchain.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DisasterChain requires your location to determine local flood hazards, navigate to nearest open civil shelters, and attach precise coordinates to emergency SOS transmissions.",
        "NSCameraUsageDescription": "DisasterChain requires camera access to document water levels, structural collapses, and hazards for civil verification.",
        "NSPhotoLibraryUsageDescription": "DisasterChain allows uploading ground photos to verify community incident dispatches."
      }
    },
    "android": {
      "package": "com.disasterchain.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D0E0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DisasterChain requires your location to assess active flood risks and route to nearest open civil shelters."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D66A35",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0E0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://disasterchain.vercel.app/api",
      "router": {},
      "eas": {
        "projectId": "4c4d9a8d-88ce-441c-ad81-8f66466b031c"
      }
    },
    "owner": "disasterchain"
  }
}
